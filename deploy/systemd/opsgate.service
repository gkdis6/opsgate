[Unit]
Description=opsgate authenticated MCP HTTP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=opsgate
Group=opsgate
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/opsgate -transport http -config /etc/opsgate/opsgate.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=opsgate
StateDirectoryMode=0700
LogsDirectory=opsgate
LogsDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
NoNewPrivileges=yes

# Optional host_service_restart: command_prefix: [/usr/bin/sudo, -n]
# requires a drop-in with NoNewPrivileges=no and an exact sudoers rule:
# opsgate ALL=(root) NOPASSWD: /usr/bin/systemctl restart -- myapp.service
# Produced argv: sudo -n /usr/bin/systemctl restart -- <unit>
# An empty CapabilityBoundingSet also prevents sudo gaining root's capabilities.
# For this optional mode, replace it in the drop-in with the minimal capabilities
# required by your sudo/PAM policy (commonly CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE).
# Keep the restart allowlist exact; never grant wildcard systemctl access.

[Install]
WantedBy=multi-user.target
